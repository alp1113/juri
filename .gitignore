assets/clubs/
assets/stadiums/
assets/portraits/

# Holds the Supabase URL and publishable key. The key is public by design and
# already ships inside the built bundle, but a key sitting in a public repo is
# harvested by automated scanners in a way a 3.5 MB minified bundle is not.
lib/core/config.dart
